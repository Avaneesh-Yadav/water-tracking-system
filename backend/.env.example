# Server
PORT=3000
NODE_ENV=development
WEB_URL=http://localhost:5173

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=water_management

# JWT (use strong random values in production)
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_different_from_jwt_secret

# Token lifetime: access (default 24h), refresh (default 7d)
# Examples: 15m, 1h, 24h, 7d
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# UPI ID is set in app via Admin > Settings (app_settings.upi_id)
# Payments via QR go directly to that admin UPI account.
# Optional: SMS (Twilio / MSG91 / Fast2SMS / AWS SNS)
# SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
